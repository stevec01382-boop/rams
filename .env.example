# Copy this file to .env for local dev (netlify dev picks it up automatically).
# In production, set these in Netlify: Site settings -> Environment variables.

# Resend (https://resend.com) API key used to email the finished, signed RAMS PDF.
RESEND_API_KEY=

# "From" address for outgoing emails. Must be on a domain verified in Resend.
RESEND_FROM_EMAIL="Hutchi RAMS <rams@hutchi.tech>"

# Simple shared passcode that protects the /records page and its API calls.
# Not a substitute for real auth, but stops the stored RAMS (names, signatures,
# site addresses) being publicly browsable. Change this before going live.
RAMS_ADMIN_PASSCODE=change-me

# Netlify Blobs works automatically on Netlify (no keys needed) once the site
# is deployed. No action needed here for production; blobs are unavailable
# when running `vite` directly (use `netlify dev` to test storage locally).
